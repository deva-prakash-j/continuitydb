{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "continuitydb": {
      "type": "remote",
      "url": "https://continuitydb.example/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:CONTINUITYDB_MCP_TOKEN}"
      },
      "timeout": 30000
    }
  },
  "plugin": ["./.opencode/plugins/continuitydb.js"]
}

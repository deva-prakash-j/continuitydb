{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "continuitydb-hook",
            "args": ["session-start", "--client", "claude"],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "continuitydb-hook",
            "args": ["checkpoint", "--file", ".continuitydb-handoff.json"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}

{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "continuitydb",
            "args": [
              "hook",
              "session-start",
              "--client",
              "claude",
              "--project",
              "inventory-service",
              "--home",
              "/absolute/private/path/continuitydb-data",
              "--tenant-id",
              "example-org",
              "--owner-id",
              "example-user",
              "--agent-id",
              "claude",
              "--allowed-sensitivities",
              "public,private"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "continuitydb",
            "args": [
              "hook",
              "checkpoint",
              "--client",
              "claude",
              "--project",
              "inventory-service",
              "--home",
              "/absolute/private/path/continuitydb-data",
              "--tenant-id",
              "example-org",
              "--owner-id",
              "example-user",
              "--agent-id",
              "claude",
              "--allowed-sensitivities",
              "public,private",
              "--file",
              "/workspace/inventory-service/.continuitydb-handoff.json"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
